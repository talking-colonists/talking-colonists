<window xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" size="400 244"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/ldtteam/BlockUI/version/main/src/main/resources/assets/blockui/gui/block_ui.xsd">
    <image source="minecolonies:textures/gui/builderhut/builder_paper_wide2.png" size="400 244"/>

    <text size="400 13" pos="0 13" color="black" textalign="MIDDLE" label="$(item.mc_talking.colony_handbook)"/>

    <text size="120 10" pos="22 32" color="#555555" textscale="0.8" label="$(mc_talking.handbook.chapters)"/>
    <list id="chapters" size="128 190" pos="18 44">
        <view size="100% 20">
            <button id="chapter" size="122 18" pos="0 1" textscale="0.75" textcolor="black" texthovercolor="#8a5a2b"
                    source="minecolonies:textures/gui/builderhut/builder_button_medium.png"/>
        </view>
    </list>

    <text id="chapterTitle" size="220 12" pos="156 31" color="black"/>
    <list id="paragraphs" size="226 190" pos="154 44">
        <view size="100% 44">
            <text id="paragraph" size="216 42" pos="2 1" color="#333333" textscale="0.7" wrap="true"/>
        </view>
    </list>
    <!-- Last, so it is on top: the full-width title under it would otherwise take its clicks. -->
    <button id="close" size="14 15" pos="375 10" source="minecolonies:textures/gui/button_x.png" textcolor="black" texthovercolor="#8a5a2b"/>
</window>
